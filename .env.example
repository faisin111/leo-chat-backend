DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_app_db
DB_USER=leochat
DB_PASSWORD=secretpassword
# Generate your own value with: openssl rand -base64 32
JWT_SECRET=

# Stateless JSON bearer authentication
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=leo-chat-api
JWT_AUDIENCE=leo-chat-clients
# Enable only with your own bootstrap credentials
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase S3-compatible image storage. Get keys from Storage settings.
SUPABASE_STORAGE_ENABLED=false
SUPABASE_STORAGE_ENDPOINT=https://lzkeptvooqgodjbngsyh.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=ap-southeast-1
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=images
SUPABASE_STORAGE_UPLOAD_EXPIRY_SECONDS=900
SUPABASE_STORAGE_DOWNLOAD_EXPIRY_SECONDS=900
SUPABASE_STORAGE_MAX_IMAGE_BYTES=10485760

# Recovery links point to your client application
FRONTEND_URL=http://localhost:3000
# Exact browser origins, comma-separated. Example: https://app.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
MAIL_STARTTLS_REQUIRED=false

# Local HTTP cookie development; use true for HTTPS deployment
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
